# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# admin-uploaded media (runtime artifacts, not source)
/public/uploads/*
!/public/uploads/.gitkeep

# pre-optimisation image originals (kept locally, not shipped)
/assets-original

# Firebase service account keys (NEVER commit these)
*-firebase-adminsdk-*.json
firebase-service-account*.json

# Source archives and photo drops kept beside the project, never shipped.
# GitHub rejects any push containing a file over 100 MB, and "New folder.rar"
# alone is 287 MB — without these rules a plain `git add -A` makes the whole
# push fail with a pre-receive hook error that names the file, not the cause.
*.rar
*.zip
/Products

# Throwaway screenshots from local checking.
/mobile-*.png
/hero-*.png
/shop-*.png
/check-*.png
